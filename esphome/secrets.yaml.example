# Copy this file to  esphome/secrets.yaml  and fill in real values.
# esphome/secrets.yaml is git-ignored.

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Fallback hotspot the clock exposes if Wi-Fi fails (min 8 chars)
ap_password: "changeme8+"

# API encryption key — 32 random bytes, base64. Regenerate your own with:
#   openssl rand -base64 32
api_key: "EmifqIHHI+YqkdnCUhg48rgPIKFAVT6IDM0GWfSsfMc="

# OTA / update password
ota_password: "change-this-ota-password"

# Only needed if you uncomment web_server > auth in secondclock.yaml
web_password: "change-this-web-password"
